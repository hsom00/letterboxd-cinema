# ---- Letterboxd Cinema settings (copy to .env, or let scripts/install.* write this for you) ----

# The name, your account and your Letterboxd username are chosen in the browser on first visit (onboarding);
# APP_NAME here is only a fallback.
APP_NAME=Cinema

# Where things live on this machine. Forward slashes work on Windows too (D:/Media).
MEDIA_PATH=D:/Media
CONFIG_PATH=D:/Cinema/config

TZ=Europe/London
PUID=1000
PGID=1000

# Access. Either a public hostname you own (HTTPS is automatic) or ":80" for LAN-only.
SITE_ADDRESS=:80
# For a public hostname on Cloudflare DNS, also set:
#COMPOSE_PROFILES=public
#CLOUDFLARE_API_TOKEN=

# Updates: installs follow the published 'stable' images; Watchtower pulls new ones weekly.
# CHANNEL=main follows every commit instead. For development, build from this folder:
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
CHANNEL=stable

# NVIDIA GPU transcoding for Jellyfin:
#COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml

# Ports on this machine (change only if something else already uses them)
HTTP_PORT=80
HTTPS_PORT=443
PEER_PORT=51413
DISCOVERY_PORT=7359

# Optional tuning
MAX_MB_PER_MINUTE=150
SEED_RATIO=1.0

# Service API keys. The install script generates these and writes them into each app's config
# before first start, so nothing needs copying by hand.
RADARR_API_KEY=
PROWLARR_API_KEY=
